{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": ["mise", "run", "tool:lsp"],
      "extensions": [".ts", ".tsx"],
    },
  },
  "skills": [".agents/tool-skills"],
  "promptPayload": {
    "indexIgnores": ["sample/"],
    "description": "Directories for OpenCode to reduce/prioritize-index on load; keeps TPM low for Google AI Studio free tier",
  },
}
