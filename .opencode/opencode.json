{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": ["mise", "run", "lsp"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  },
  "mcp": {
    "mise": {
      "type": "local",
      "command": ["mise", "mcp"],
      "enabled": true
    }
  }
}
